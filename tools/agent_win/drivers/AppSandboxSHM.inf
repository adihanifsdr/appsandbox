; AppSandboxSHM.inf — AppSandbox ivshmem BAR-mapping driver (KMDF). Our own code, no third party.
; Binds QEMU's ivshmem-plain PCI device. The SUBSYS-qualified hardware ID is more specific than
; the inbox "PCI standard RAM Controller" match, so PnP ranks this driver higher and binds it.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = AppSandboxSHM.cat
PnpLockdown = 1
DriverVer = 06/22/2026,0.1.3.0
; DriverVer is stamped by the build (stampinf).

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
AppSandboxSHM.sys = 1

[Manufacturer]
; The .10.0...22000 TargetOSVersion decoration restricts install to Windows 11 (10.0.22000+), which
; is what AppSandbox requires. It also clears InfVerif error 1199: DefaultDestDir = 13 (run-from-
; driver-store, needed for PnpLockdown=1) was introduced in 10.0.16299, so a min-OS decoration is
; mandatory -- 22000 is well above that. Both arches declared (the project builds x64 + ARM64).
%ManufacturerName% = Standard,NTamd64.10.0...22000,NTARM64.10.0...22000

[Standard.NTamd64.10.0...22000]
; Most-specific match first (SUBSYS) so we outrank the generic inbox RAM-controller driver.
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110&SUBSYS_11001AF4&REV_01
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110&SUBSYS_11001AF4
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110

[Standard.NTARM64.10.0...22000]
; Most-specific match first (SUBSYS) so we outrank the generic inbox RAM-controller driver.
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110&SUBSYS_11001AF4&REV_01
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110&SUBSYS_11001AF4
%DeviceDesc% = ASB_Install, PCI\VEN_1AF4&DEV_1110

[ASB_Install.NT]
CopyFiles = ASB_Copy

[ASB_Copy]
AppSandboxSHM.sys

[ASB_Install.NT.Services]
AddService = AppSandboxSHM, 0x00000002, ASB_Service

[ASB_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\AppSandboxSHM.sys

[ASB_Install.NT.Wdf]
KmdfService = AppSandboxSHM, asb_wdfsect

[asb_wdfsect]
; VERIFY against the installed WDK (e.g. 1.31/1.33). stampinf -k can set this from the build.
KmdfLibraryVersion = 1.33

[Strings]
ManufacturerName = "AppSandbox"
DiskName         = "AppSandbox Shared Memory Install Disk"
DeviceDesc       = "AppSandbox Shared Memory"
ServiceDesc      = "AppSandbox Shared Memory Driver"

