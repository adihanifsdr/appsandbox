#!/usr/bin/env python3
"""
nestbox-app - panel Nestbox sebagai jendela GTK native di host Linux.

Padanan dari jendela WebView2 yang dipakai Nestbox.exe: server `nestbox`
(root, libvirt + /dev/kvm) dinyalakan lewat pkexec kalau belum jalan, lalu
UI-nya ditampilkan di satu Gtk.Window lewat WebKitGTK, bukan di browser.
Setiap layar replica (viewer, grid) yang dibuka panel mendapat jendela GTK
sendiri, persis "a window per screen" di Windows. Menutup jendela tidak
mematikan server: replica yang berjalan tetap berjalan.

    tools/linux/host/nestbox-app                 # port 8765
    tools/linux/host/nestbox-app --port 9000

Butuh python3-gi + gir1.2-webkit2-4.1 (bawaan Ubuntu Desktop).
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time
import urllib.request

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, GLib, Gtk, WebKit2  # noqa: E402

# The UI measures its table and asks the host for a minimum window size
# ("setMinSize"; Nestbox.exe honours it, the Linux server ignores it). It
# talks to the server over a WebSocket, so this user script watches the
# frames it sends and hands setMinSize to the window through a WebKit
# message handler. Named anything but "host": app.js takes a "host" handler
# to mean WKWebView (macOS) and would stop using the WebSocket.
MIN_SIZE_HOOK = """
(function () {
    var send = WebSocket.prototype.send;
    WebSocket.prototype.send = function (data) {
        try {
            var m = JSON.parse(data);
            if (m && m.action === 'setMinSize')
                window.webkit.messageHandlers.gtkWindow.postMessage(JSON.stringify(m));
        } catch (e) {}
        return send.call(this, data);
    };
})();
"""

# A screen window (viewer.html) at 1:1 wants to be exactly as large as the
# framebuffer plus its bar; Nestbox.exe sizes its WebView2 window so, the
# browser cannot. When the Fit / 1:1 button lands on 1:1 (or a console
# connects while 1:1 is on) the page asks the window to fit the canvas.
VIEWER_FIT_HOOK = """
(function () {
    function fit() {
        if (window.scaled !== false) return;
        var c = document.querySelector('#vnc-screen canvas'), bar = document.getElementById('vnc-bar');
        if (!c || !c.width) return;
        window.webkit.messageHandlers.gtkWindow.postMessage(JSON.stringify(
            { action: 'fitWindow', width: c.width, height: c.height + (bar ? bar.offsetHeight : 0) }));
    }
    document.addEventListener('DOMContentLoaded', function () {
        if (!document.getElementById('vnc-screen')) return;
        var toggle = window.vncToggleScale;
        if (typeof toggle === 'function')
            window.vncToggleScale = function () { toggle.apply(this, arguments); setTimeout(fit, 50); };
        /* the canvas appears when the console connects, and grows with the framebuffer */
        new MutationObserver(function () { setTimeout(fit, 50); })
            .observe(document.getElementById('vnc-screen'), { childList: true, subtree: true, attributes: true, attributeFilter: ['width', 'height'] });
    });
})();
"""


def content_manager(handler):
    """Both hooks, with the page -> window channel wired to `handler`."""
    ucm = WebKit2.UserContentManager()
    for src in (MIN_SIZE_HOOK, VIEWER_FIT_HOOK):
        ucm.add_script(WebKit2.UserScript(
            src, WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START, None, None))
    ucm.connect("script-message-received::gtkWindow", handler)
    ucm.register_script_message_handler("gtkWindow")
    return ucm


def workarea():
    """Usable width and height of the monitor (minus panels), for clamping windows."""
    try:
        d = Gdk.Display.get_default()
        m = d.get_primary_monitor() or d.get_monitor(0)
        g = m.get_workarea()
        return g.width, g.height
    except Exception:
        return 1920, 1080

TITLE = "Nestbox"
WMCLASS = "Nestbox"
ICON = "nestbox"
SIZE = (1400, 860)          # wide enough for every icon column; setMinSize below pins the floor
VIEWER_SIZE = (1024, 768)


def serving(url):
    try:
        urllib.request.urlopen(url, timeout=1).read(1)
        return True
    except Exception:
        return False


def ensure_server(port):
    """Nyalakan server sebagai root lewat pkexec kalau port belum menjawab."""
    url = "http://127.0.0.1:%d/" % port
    if serving(url):
        return url
    server = os.path.join(os.path.dirname(os.path.abspath(__file__)), "nestbox")
    log = open(os.path.expanduser("~/.cache/nestbox.log"), "ab")
    subprocess.Popen(["pkexec", server, "--port", str(port), "--no-browser"],
                     stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    # Run pertama memasang qemu/libvirt, jadi sabar.
    for _ in range(600):
        if serving(url):
            return url
        time.sleep(1)
    sys.exit("server nestbox tidak menjawab di %s; lihat ~/.cache/nestbox.log" % url)


class Window(Gtk.Window):
    # Jendela viewer ikut dihitung: aplikasi keluar saat jendela terakhir tutup.
    count = 0

    def __init__(self, url, size, related=None):
        super().__init__(title=TITLE)
        Window.count += 1
        self.connect("destroy", Window.closed)
        self.set_default_size(*size)
        self.set_icon_name(ICON)
        ucm = content_manager(self.on_page_message)
        if related:
            self.view = WebKit2.WebView(related_view=related, user_content_manager=ucm)
        else:
            self.view = WebKit2.WebView(user_content_manager=ucm)
        s = self.view.get_settings()
        s.set_javascript_can_open_windows_automatically(True)
        s.set_allow_modal_dialogs(True)
        self.view.connect("create", self.on_create)
        self.view.connect("notify::title", self.on_title)
        self.view.connect("close", lambda *_: self.destroy())
        # the web process can die under it (seen: WebKit's ThreadedCompositor
        # hitting an assertion while a 1600x900 screen was open, RAM nearly
        # gone) and the window stays white; reload instead of staying blank
        self.view.connect("web-process-terminated", self.on_terminated)
        self.add(self.view)
        if url:
            self.view.load_uri(url)
        self.show_all()

    @staticmethod
    def closed(_):
        Window.count -= 1
        if Window.count <= 0:
            Gtk.main_quit()

    def on_title(self, view, _):
        self.set_title(view.get_title() or TITLE)

    def on_terminated(self, view, reason):
        print("web process gone (%s): reloading" % reason.value_nick, flush=True)
        GLib.timeout_add(1000, lambda: (view.reload(), False)[1])

    # Messages from the page through the gtkWindow handler:
    #   setMinSize  - the panel: the window can never be narrower than its table
    #   fitWindow   - a screen at 1:1: the window takes the framebuffer's size
    def on_page_message(self, _ucm, result):
        try:
            m = json.loads(result.get_js_value().to_string())
            w, h = int(m["width"]), int(m["height"])
        except (ValueError, KeyError, TypeError, AttributeError):
            return
        if m.get("action") == "fitWindow":
            mw, mh = workarea()
            w, h = min(w, mw - 16), min(h, mh - 56)     # room for the title bar
            print("screen window %dx%d (1:1)" % (w, h), flush=True)
            self.set_size_request(320, 240)
            self.resize(w, h)
            return
        print("window minimum %dx%d (asked by the page)" % (w, h), flush=True)
        self.set_size_request(w, h)
        cw, ch = self.get_size()
        if cw < w or ch < h:
            self.resize(max(cw, w), max(ch, h))

    # window.open() from the panel (a replica's screen, the grid) -> a GTK
    # window of its own, at the size the page asked for (the server sends the
    # framebuffer plus the bar, so 1:1 fits from the start), clamped to the
    # monitor.
    def on_create(self, view, _nav):
        w = Window(None, VIEWER_SIZE, related=view)

        def shown(v):
            try:
                g = v.get_window_properties().get_geometry()
                mw, mh = workarea()
                if g.width > 0 and g.height > 0:
                    w.resize(min(g.width, mw - 16), min(g.height, mh - 56))
            except Exception:
                pass
            w.present()
        w.view.connect("ready-to-show", shown)
        return w.view


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--port", type=int, default=8765)
    a = p.parse_args()

    GLib.set_prgname(WMCLASS)
    GLib.set_application_name(TITLE)
    url = ensure_server(a.port)
    Window(url, SIZE)
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    Gtk.main()


if __name__ == "__main__":
    main()
