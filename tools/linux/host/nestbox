# ---------------------------------------------------------------- WebSocket

class WebSocket:
    """A server-side RFC 6455 socket over an accepted TCP connection."""

    def __init__(self, sock):
        self.sock = sock
        self.lock = threading.Lock()
        self.open = True

    @staticmethod
    def accept_key(key):
        return base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()

    def _recv_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("closed")
            buf += chunk
        return buf

    def recv(self):
        """One complete message: (opcode, payload). Pings are answered here."""
        msg = b""
        opcode = None
        while True:
            h = self._recv_exact(2)
            fin, op, masked, ln = h[0] & 0x80, h[0] & 0x0F, h[1] & 0x80, h[1] & 0x7F
            if ln == 126:
                ln = struct.unpack(">H", self._recv_exact(2))[0]
            elif ln == 127:
                ln = struct.unpack(">Q", self._recv_exact(8))[0]
            mask = self._recv_exact(4) if masked else None
            data = self._recv_exact(ln)
            if mask:
                m = (mask * (ln // 4 + 1))[:ln]
                data = bytes(a ^ b for a, b in zip(data, m))
            if op == 0x8:
                self.open = False
                return 0x8, data
            if op == 0x9:
                self.send(data, 0xA)
                continue
            if op == 0xA:
                continue
            if op:
                opcode = op
            msg += data
            if fin:
                return opcode, msg

    def send(self, data, opcode=0x2):
        if isinstance(data, str):
            data, opcode = data.encode(), 0x1
        n = len(data)
        if n < 126:
            hdr = bytes([0x80 | opcode, n])
        elif n < 65536:
            hdr = bytes([0x80 | opcode, 126]) + struct.pack(">H", n)
        else:
            hdr = bytes([0x80 | opcode, 127]) + struct.pack(">Q", n)
        with self.lock:
            self.sock.sendall(hdr + data)

    def close(self):
        self.open = False
        try:
            self.sock.close()
        except OSError:
            pass


def ws_handshake_raw(sock):
    """Read an HTTP upgrade request from a raw socket and answer it.
    Returns the WebSocket, or None when it was not an upgrade."""
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            return None
        buf += chunk
        if len(buf) > 65536:
            return None
    head = buf.split(b"\r\n\r\n", 1)[0].decode(errors="replace")
    headers = {}
    for line in head.split("\r\n")[1:]:
        if ":" in line:
            k, v = line.split(":", 1)
            headers[k.strip().lower()] = v.strip()
    key = headers.get("sec-websocket-key")
    if not key or "upgrade" not in headers.get("connection", "").lower():
        sock.sendall(b"HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
        return None
    resp = ("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            "Sec-WebSocket-Accept: %s\r\n" % WebSocket.accept_key(key))
    proto = headers.get("sec-websocket-protocol")
    if proto:
        resp += "Sec-WebSocket-Protocol: %s\r\n" % proto.split(",")[0].strip()
    sock.sendall((resp + "\r\n").encode())
    return WebSocket(sock)

# ------------------------------------------------------------ VNC bridges
# Served on the UI port itself as ws://<host>:<port>/vnc/<vnc port>, so one
# SSH tunnel (-L 8765:127.0.0.1:8765) carries the UI and every console.

def _pipe_ws_to_tcp(ws, tcp):
    try:
        while ws.open:
            op, data = ws.recv()
            if op == 0x8:
                break
            if data:
                tcp.sendall(data)
    except (OSError, ConnectionError):
        pass
    finally:
        try:
            tcp.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass


def _pipe_tcp_to_ws(ws, tcp):
    try:
        while True:
            data = tcp.recv(65536)
            if not data:
                break
            ws.send(data, 0x2)
    except (OSError, ConnectionError):
        pass
    finally:
        ws.close()


def bridge_vnc(ws, vnc_port):
    """Pipe an accepted WebSocket to 127.0.0.1:<vnc_port> until either side closes."""
    tcp = None
    try:
        tcp = socket.create_connection(("127.0.0.1", vnc_port), timeout=5)
        tcp.settimeout(None)
        t = threading.Thread(target=_pipe_tcp_to_ws, args=(ws, tcp), daemon=True)
        t.start()
        _pipe_ws_to_tcp(ws, tcp)
        t.join()
    except (OSError, ConnectionError) as e:
        log("VNC bridge to 127.0.0.1:%d: %s" % (vnc_port, e))
    finally:
        if tcp:
            tcp.close()
        ws.close()


def vnc_bridge(vnc_port):
    """The WebSocket path the viewer page uses for a console."""
    return "/vnc/%d" % vnc_port

# -------------------------------------------------------------- UI clients

_clients = set()
_clients_lock = threading.Lock()


def broadcast(msg):
    data = json.dumps(msg)
    with _clients_lock:
        clients = list(_clients)
    for ws in clients:
        try:
            ws.send(data)
        except (OSError, ConnectionError):
            with _clients_lock:
                _clients.discard(ws)


def log(message):
    line = str(message)
    print(line, flush=True)
    broadcast({"type": "log", "message": line})

# ------------------------------------------------------------- host facts

def _os_name():
    try:
        for line in open("/etc/os-release"):
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Linux"


def _gpu_name():
    try:
        out = subprocess.run(["lspci"], capture_output=True, text=True, timeout=5).stdout
        for line in out.splitlines():
            if re.search(r"VGA|3D controller|Display controller", line):
                name = line.split(": ", 1)[1] if ": " in line else line
                name = re.sub(r"\s*\(rev [0-9a-f]+\)\s*$", "", name)
                # "Intel Corporation TigerLake-LP GT2 [Iris Xe Graphics]" -> "Intel Iris Xe Graphics":
                # the bracketed marketing name, with the vendor's first word, keeps the row narrow
                m = re.match(r"^(\S+)(?: Corporation| Inc\.?| Ltd\.?| Co\.?)*\b.*\[([^\]]+)\]\s*$", name)
                if m:
                    vendor = {"Advanced": "AMD"}.get(m.group(1), m.group(1))
                    name = "%s %s" % (vendor, m.group(2)) if not m.group(2).startswith(vendor) else m.group(2)
                return name[:48]
    except (OSError, subprocess.SubprocessError):
        pass
    return "host GPU"


OS_NAME = _os_name()
GPU_NAME = _gpu_name()
CORES = os.cpu_count() or 1


def _mem_mb():
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) // 1024
    except OSError:
        pass
    return 0


RAM_MB = _mem_mb()


def host_info(reps):
    st = os.statvfs("/")
    running = [r for r in reps if r.get("state") == "running"]
    return {
        "hostCores": CORES, "hostRamMb": RAM_MB,
        "freeGb": st.f_bavail * st.f_frsize // 2 ** 30,
        "vmCores": sum(int(r.get("cpus") or 0) for r in running),
        "vmRamMb": sum(int(r.get("ram") or 0) for r in running),
        "vmHddGb": sum(int(r.get("disk") or 0) for r in reps),
    }

# ---------------------------------------------------------------- replicas

def have(cmd):
    return shutil.which(cmd) is not None


def run_tool(args, timeout=600, tool=REPLICA_TOOL):
    """appsandbox-replica (or -seat) <args>; returns (rc, output)."""
    try:
        p = subprocess.run([tool] + args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr)
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


def run_tool_streaming(args, tag, tool=REPLICA_TOOL):
    """appsandbox-replica (or -seat) <args> with every output line in the UI log."""
    try:
        p = subprocess.Popen([tool] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, stdin=subprocess.DEVNULL)
    except OSError as e:
        log("[%s] %s" % (tag, e))
        return 1
    for line in p.stdout:
        line = line.rstrip()
        if line:
            log("[%s] %s" % (tag, line))
    return p.wait()


def _tool_list(tool):
    rc, out = run_tool(["list"], timeout=60, tool=tool)
    if rc != 0:
        return []
    try:
        v = json.loads(out)
        return v if isinstance(v, list) else []
    except ValueError:
        return []


def replica_list():
    """The replicas [{name,state,vnc,desktop,cpus,ram,disk}, ...] (none without
    libvirt) followed by the Steam seats [{name,state,vnc,desktop,kind:"seat",res}, ...]."""
    out = []
    if os.path.exists(REPLICA_TOOL) and have("virsh"):
        out += _tool_list(REPLICA_TOOL)
    if os.path.exists(SEAT_TOOL):
        out += _tool_list(SEAT_TOOL)
    return out


def host_entry(reps):
    legacy = "running" if any(r.get("state") == "running" for r in reps) else ("stopped" if reps else "none")
    st = os.statvfs("/")
    return {
        "name": HOSTNAME, "isHost": True, "osType": "Linux", "osName": OS_NAME,
        "running": True, "agentOnline": True, "installComplete": True, "isTemplate": False,
        "buildingVhdx": False, "shuttingDown": False, "progress": 100,
        "cpuCores": CORES, "ramMb": RAM_MB, "hddGb": st.f_blocks * st.f_frsize // 2 ** 30,
        "gpuMode": 1, "gpuName": GPU_NAME, "networkMode": 1,
        "sshEnabled": False, "sshState": 0, "sshPort": 0, "vncPort": 0,
        "replica": legacy, "replicas": json.dumps(reps, separators=(",", ":")),
        "replicaAuto": False, "hasIdentity": os.path.exists(PROFILE),
        "snapshots": [], "baseBranches": [], "hasSnapshots": False,
        # the identity-patched QEMU: built once on this PC, used by every replica
        "qemuPatched": os.path.exists(QEMU_STAMP),
        "qemuBuilding": "*qemu" in _busy,
        "kvm": os.path.exists("/dev/kvm"),
    }


_last_list = None
_list_lock = threading.Lock()


def state_message(kind="vmListChanged"):
    reps = replica_list()
    return {"type": kind, "vms": [host_entry(reps)], "hostInfo": host_info(reps)}


def push_state(force=False):
    global _last_list
    msg = state_message()
    with _list_lock:
        changed = msg["vms"][0]["replicas"] != _last_list
        _last_list = msg["vms"][0]["replicas"]
    if changed or force:
        broadcast(msg)


def refresh_loop():
    n = 0
    while True:
        time.sleep(5)
        n += 1
        try:
            push_state(force=(n % 6 == 0))
        except Exception as e:  # keep the loop alive
            print("refresh:", e, file=sys.stderr)


_busy = set()
_busy_lock = threading.Lock()


def run_replica_job(name, tag, steps, tool=REPLICA_TOOL):
    """steps: [(args, description)]; stops at the first failure. Detached."""
    with _busy_lock:
        if name in _busy:
            log("[%s] busy, try again when the current step is done." % name)
            return
        _busy.add(name)

    def job():
        try:
            for args, desc in steps:
                log("[%s] %s ..." % (tag, desc))
                rc = run_tool_streaming(args, tag, tool)
                if rc != 0:
                    log("[%s] %s failed (rc=%d)." % (tag, desc, rc))
                    return
            log("[%s] done." % tag)
        finally:
            with _busy_lock:
                _busy.discard(name)
            push_state(force=True)
    threading.Thread(target=job, daemon=True).start()

# ------------------------------------------------------------- desktop user

def desktop_user():
    if os.environ.get("PKEXEC_UID", "").isdigit():      # started through pkexec (nestbox-app)
        try:
            return pwd.getpwuid(int(os.environ["PKEXEC_UID"]))
        except KeyError:
            pass
    name = os.environ.get("SUDO_USER") or os.environ.get("USER") or "root"
    try:
        return pwd.getpwnam(name)
    except KeyError:
        return pwd.getpwuid(os.getuid())


def steam_library_with(app_id):
    """The desktop user's Steam folder (snap or apt Steam) that has app_id installed, or None."""
    home = desktop_user().pw_dir
    for d in ("snap/steam/common/.local/share/Steam", ".local/share/Steam", ".steam/steam"):
        lib = os.path.join(home, d)
        if os.path.isfile(os.path.join(lib, "steamapps", "appmanifest_%s.acf" % app_id)):
            return lib
    return None


def run_as_desktop_user(cmd):
    """Start a desktop program (browser, VNC viewer) as the logged-in user."""
    u = desktop_user()
    env = dict(os.environ)
    env.update({"HOME": u.pw_dir, "USER": u.pw_name, "LOGNAME": u.pw_name,
                "XDG_RUNTIME_DIR": env.get("XDG_RUNTIME_DIR") or "/run/user/%d" % u.pw_uid})
    if "DBUS_SESSION_BUS_ADDRESS" not in env:
        env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=%s/bus" % env["XDG_RUNTIME_DIR"]
    kw = {}
    if os.getuid() == 0 and u.pw_uid != 0:
        kw = {"user": u.pw_uid, "group": u.pw_gid}
    try:
        subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, **kw)
        return True
    except (OSError, subprocess.SubprocessError, TypeError) as e:
        log("could not start %s: %s" % (cmd[0], e))
        return False

# --------------------------------------------------------------- actions

ARGS = None


def sizing_args(msg):
    out = []
    for key, flag, lo, hi, suffix in (("cpus", "--cpus", 1, 256, ""), ("ram", "--ram", 256, 1048576, ""),
                                      ("disk", "--disk", 1, 65536, "G")):
        v = msg.get(key)
        if isinstance(v, (int, float)) and lo <= int(v) <= hi:
            out += [flag, "%d%s" % (int(v), suffix)]
    return out


def clean_name(name):
    name = re.sub(r"[^A-Za-z0-9._-]", "-", str(name or "replica"))[:63]
    return name or "replica"


def seat_name(name):
    """A seat is a Linux user: lowercase letters, digits, - _, a letter first."""
    name = re.sub(r"[^a-z0-9_-]", "-", str(name or "seat").lower())
    name = re.sub(r"^[^a-z]+", "", name)[:31]
    return name or "seat"


def handle(msg, ws):
    action = msg.get("action")
    if action == "uiReady":
        ws.send(json.dumps(state_message("fullState")))
        return
    if action in ("selectVm", "reportMinSize", "browse", "getTemplates", "getAdapters"):
        return

    if action in ("seatStart", "seatStop", "seatRestart", "seatDestroy", "seatCreate"):
        # Steam seats: appsandbox-seat on this PC (a user + Xvnc + XFCE + Steam), no KVM needed
        sname = seat_name(msg.get("name"))
        if not os.path.exists(SEAT_TOOL):
            log("[%s] appsandbox-seat is not installed (expected next to nestbox or in ../seat)." % sname)
            return
        if action == "seatCreate":
            if any(r.get("name") == sname for r in replica_list()):
                log("[%s] already exists." % sname)
                return
            args = ["-n", sname, "create"]
            res = str(msg.get("res") or "")
            if re.match(r"^\d{3,5}x\d{3,5}$", res):
                args += ["--resolution", res]
            if msg.get("steam") is False:
                args.append("--no-steam")
            # a game at login, its files from this PC's library, extra programs
            app = str(msg.get("steamApp") or "").strip()
            if app.isdigit():
                args += ["--steam-app", app]
                if msg.get("copyGame"):
                    lib = steam_library_with(app)
                    if lib:
                        args += ["--copy-app-from", lib]
                    else:
                        log("[%s] app %s is not installed in %s's Steam library on this PC; the seat downloads it itself."
                            % (sname, app, desktop_user().pw_name))
            for entry in msg.get("autostart") or []:
                entry = str(entry).strip()
                if re.match(r"^[^=\s][^=]*=\S", entry):
                    args += ["--autostart", entry]
            run_replica_job(sname, sname, [(args, "creating the Steam seat (packages the first time, ~1.5 GB)")], tool=SEAT_TOOL)
        else:
            sub = action[4:].lower()
            run_replica_job(sname, sname, [(["-n", sname, sub], {"start": "starting", "stop": "stopping",
                                            "restart": "restarting", "destroy": "deleting"}[sub])], tool=SEAT_TOOL)
        return

    name = clean_name(msg.get("name"))
    if action == "replicaStart":
        run_replica_job(name, name, [(["-n", name, "start"], "starting")])
    elif action == "replicaStop":
        run_replica_job(name, name, [(["-n", name, "stop"], "shutting down")])
    elif action == "replicaRestart":
        # one tool command: "stop" is an async ACPI button, so stop-then-start
        # in two steps hits "Domain is already active"; restart waits in between
        run_replica_job(name, name, [(["-n", name, "restart"], "restarting")])
    elif action == "replicaDestroy":
        run_replica_job(name, name, [(["-n", name, "destroy"], "deleting")])
    elif action == "replicaDesktop":
        run_replica_job(name, name, [(["-n", name, "desktop"], "installing XFCE + Steam (10-20 min)")])
    elif action == "replicaResize":
        args = sizing_args(msg) + (["--restart"] if msg.get("restart") else [])
        run_replica_job(name, name, [(["-n", name, "resize"] + args, "resizing")])
    elif action == "qemuBuild":
        # the button on the PC row: the identity-patched QEMU, no replica needed
        if os.path.exists(QEMU_STAMP):
            log("[qemu] the identity-patched QEMU is already installed.")
            push_state(force=True)
            return
        run_replica_job("*qemu", "qemu", [(["install"], "installing qemu / libvirt"),
                                          (["qemu", "build"], "building the identity-patched QEMU (~10 min)")])
        push_state(force=True)
    elif action in ("replicaSetup", "replicaCreate"):
        if any(r.get("name") == name for r in replica_list()):
            log("[%s] already exists." % name)
            return
        steps = [(["install"], "installing qemu / libvirt")]
        if (ARGS.qemu_patch or msg.get("patch")) and not os.path.exists(QEMU_STAMP):
            steps.append((["qemu", "build"], "building the identity-patched QEMU (~10 min)"))
        steps.append((["-n", name, "create"] + sizing_args(msg), "creating the replica"))
        if action == "replicaSetup":
            steps.append((["-n", name, "desktop"], "installing XFCE + Steam (10-20 min)"))
        run_replica_job(name, name, steps)
    elif action == "vncOpen":
        port = int(msg.get("port") or 5900)
        url = "viewer.html?ws=%s&vm=0&port=%d&name=%s&vmName=%s&nested=1%s" % (
            urllib.parse.quote(vnc_bridge(port)), port, urllib.parse.quote(name), urllib.parse.quote(HOSTNAME),
            "&kind=seat" if msg.get("kind") == "seat" else "")
        # the window: the screen at 1:1 plus the bar (a seat's resolution is known)
        width, height = 1640, 990
        for r in replica_list():
            m = re.match(r"^(\d+)x(\d+)$", str(r.get("res") or "")) if r.get("name") == name else None
            if m:
                width, height = int(m.group(1)) + 2, int(m.group(2)) + 42
        ws.send(json.dumps({"type": "openWindow", "url": url, "width": width, "height": height}))
    elif action == "vncGrid":
        tiles = []
        for tok in str(msg.get("tiles") or "").split(","):
            parts = tok.split(":")
            if len(parts) < 2:
                continue
            n, p = parts[0], parts[1]
            kind = ":seat" if len(parts) > 2 and parts[2] == "seat" else ""   # "name:port:seat" marks a Steam seat
            try:
                p = int(p)
            except ValueError:
                continue
            tiles.append("%s:%s:%d%s" % (urllib.parse.quote(clean_name(n)), urllib.parse.quote(vnc_bridge(p)), p, kind))
        if tiles:
            url = "viewer.html?grid=1&vm=0&vmName=%s&tiles=%s" % (urllib.parse.quote(HOSTNAME), ",".join(tiles))
            ws.send(json.dumps({"type": "openWindow", "url": url, "width": 0, "height": 0}))
    elif action == "vncConnect":
        port = int(msg.get("port") or 5900)
        for cmd in (["vncviewer", "127.0.0.1::%d" % port], ["remmina", "-c", "vnc://127.0.0.1:%d" % port],
                    ["xdg-open", "vnc://127.0.0.1:%d" % port]):
            if have(cmd[0]) and run_as_desktop_user(cmd):
                log("VNC: %s" % " ".join(cmd))
                return
        log("VNC: no viewer found; connect one to 127.0.0.1:%d." % port)
    elif action == "getIdentity":
        text = ""
        try:
            text = json.dumps(json.load(open(PROFILE)), separators=(",", ":"))
        except (OSError, ValueError):
            pass
        ws.send(json.dumps({"type": "identity", "vmIndex": 0, "vmIdentity": text}))
    elif action == "setIdentity":
        text = str(msg.get("vmIdentity") or "").strip()
        try:
            if text:
                os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
                with open(PROFILE, "w") as f:
                    f.write(text + "\n")
                log("Identity profile written to %s." % PROFILE)
            elif os.path.exists(PROFILE):
                os.remove(PROFILE)
                log("Identity profile cleared.")
        except OSError as e:
            log("Identity profile: %s" % e)
            return
        if have("virsh") and replica_list():
            run_replica_job("*identity", "identity", [(["reidentify", "--all"], "redefining every replica from the profile")])
        else:
            push_state(force=True)
    else:
        log("(ignored on a Linux host: %s)" % action)

# ------------------------------------------------------------------ HTTP

class Handler(http.server.SimpleHTTPRequestHandler):
    # RFC 6455 wants the 101 on HTTP/1.1; WebKit (libsoup) drops a WebSocket whose
    # handshake came back as HTTP/1.0, which is what SimpleHTTPRequestHandler
    # answers by default. Chrome and Firefox happen to tolerate it.
    protocol_version = "HTTP/1.1"

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=ARGS.web, **kw)

    def log_message(self, fmt, *args):   # quiet
        pass

    def _upgrade(self):
        """Answer the WebSocket handshake on this request; returns the socket."""
        key = self.headers.get("Sec-WebSocket-Key")
        if not key:
            self.send_error(400)
            return None
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", WebSocket.accept_key(key))
        proto = self.headers.get("Sec-WebSocket-Protocol")
        if proto:
            self.send_header("Sec-WebSocket-Protocol", proto.split(",")[0].strip())
        self.end_headers()
        self.wfile.flush()
        self.close_connection = True
        return WebSocket(self.connection)

    def do_GET(self):
        upgrade = "upgrade" in self.headers.get("Connection", "").lower()
        m = re.match(r"^/vnc/(\d{1,5})$", self.path)
        if m and upgrade:
            ws = self._upgrade()
            if ws:
                bridge_vnc(ws, int(m.group(1)))
            return
        if self.path == "/ws" and upgrade:
            ws = self._upgrade()
            if not ws:
                return
            with _clients_lock:
                _clients.add(ws)
            try:
                while ws.open:
                    op, data = ws.recv()
                    if op == 0x8:
                        break
                    if op == 0x1:
                        try:
                            msg = json.loads(data.decode())
                        except ValueError:
                            continue
                        if isinstance(msg, dict):
                            try:
                                handle(msg, ws)
                            except Exception as e:
                                log("action %s: %s" % (msg.get("action"), e))
            except (OSError, ConnectionError):
                pass
            finally:
                with _clients_lock:
                    _clients.discard(ws)
                ws.close()
            return
        if self.path in ("/", ""):
            self.path = "/index.html"
        super().do_GET()


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

# ------------------------------------------------------------------ main

def _install_tool(srcs, dst):
    """Copy a guest tool from the checkout to /usr/local/sbin (newer wins)."""
    src = next((p for p in srcs if os.path.exists(p)), None)
    if not src:
        return os.path.exists(dst)
    if not os.path.exists(dst) or os.path.getmtime(src) > os.path.getmtime(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
        os.chmod(dst, 0o755)
        print("installed %s" % dst)
    return True


def ensure_tool():
    """appsandbox-replica (required) and appsandbox-seat (Steam seats, optional) in /usr/local/sbin."""
    _install_tool(SEAT_SRCS, SEAT_TOOL)
    if not _install_tool(REPLICA_SRCS, REPLICA_TOOL):
        return False
    # the patches for `qemu build` (the Build patch button): copy alongside
    qsrc = next((d for d in QEMU_SRC_DIRS if os.path.exists(os.path.join(d, "build.sh"))), None)
    if qsrc:
        dst_build = os.path.join(QEMU_SRC, "build.sh")
        if not os.path.exists(dst_build) or os.path.getmtime(os.path.join(qsrc, "build.sh")) > os.path.getmtime(dst_build):
            shutil.copytree(qsrc, QEMU_SRC, dirs_exist_ok=True)
            print("installed %s" % QEMU_SRC)
    return True


def main():
    global ARGS
    ap = argparse.ArgumentParser(description="Nestbox on a Linux host: replicas on this PC")
    ap.add_argument("--port", type=int, default=8765, help="UI port on 127.0.0.1 (default 8765)")
    ap.add_argument("--no-browser", action="store_true", help="do not open the browser")
    ap.add_argument("--qemu-patch", action="store_true",
                    help="build the identity-patched QEMU before creating a replica (hypervisor-level identity strings)")
    ap.add_argument("--web", help="folder with the web UI (default: the checkout's web/)")
    ARGS = ap.parse_args()
    ARGS.web = ARGS.web or next((d for d in WEB_DIRS if os.path.exists(os.path.join(d, "index.html"))), None)
    if not ARGS.web:
        sys.exit("nestbox: web UI not found (looked in %s)" % ", ".join(WEB_DIRS))
    if os.getuid() != 0:
        sys.exit("nestbox: run with sudo (libvirt and /dev/kvm need root)")
    if not os.path.exists("/dev/kvm"):
        print("nestbox: /dev/kvm is missing - enable virtualization in the firmware; replicas cannot run without it",
              file=sys.stderr)
    if not ensure_tool():
        sys.exit("nestbox: appsandbox-replica not found next to this script or in ../replica")

    srv = Server(("127.0.0.1", ARGS.port), Handler)
    url = "http://127.0.0.1:%d/" % ARGS.port
    print("Nestbox on %s (%s): %s" % (HOSTNAME, OS_NAME, url), flush=True)
    threading.Thread(target=refresh_loop, daemon=True).start()
    if not os.path.exists("/dev/kvm"):
        # no point installing libvirt: appsandbox-replica refuses without KVM
        threading.Timer(2.0, log, args=("This PC has no /dev/kvm (virtualization not exposed to it): replicas cannot run here. "
                                        "On a VPS ask the provider for nested virtualization; on bare metal enable VT-x / AMD-V in the firmware. "
                                        "Steam seats (the + button, kind \"Steam seat\") work without KVM.",)).start()
    elif not have("virsh"):
        run_replica_job("*install", "host", [(["install"], "installing qemu / libvirt (first run)")])
    if not ARGS.no_browser:
        if have("xdg-open"):
            run_as_desktop_user(["xdg-open", url])
        else:
            print("open %s in a browser" % url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
