From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Adi Hanif <adihanifsdr@gmail.com>
Date: Fri, 4 Sep 2026 15:41:56 +0700
Subject: [PATCH] util: qemu_identity_str(), environment-driven machine
 identity overrides

A guest can recognise QEMU from a handful of fixed strings: the ACPI OEM
and creator IDs, the SMBIOS default manufacturer, the vendor/model of the
emulated drives, the USB vendor strings and the CPUID hypervisor
signature. The following patches make each of them consult a
QEMU_IDENTITY_<KEY> environment variable before falling back to the
upstream value, so that the "VM identity" profile of an App Sandbox guest
can be carried down into the nested replica without a rebuild per
profile. Unset or empty variables keep the defaults, so the binary
behaves exactly like upstream unless asked not to.

qemu_identity_str() returns the override or a default; qemu_identity_fixed()
fills a fixed-width (space/NUL padded) field for the ACPI and CPUID cases.

This is the parameterised form of the hardcoded edits in
https://github.com/kila58/qemu-patched (QEMU 8.1.3, "TOSH" strings).
---
 include/qemu/identity.h | 45 +++++++++++++++++++++++++++++++++++++++++
 util/identity.c         | 29 ++++++++++++++++++++++++++
 util/meson.build        |  1 +
 3 files changed, 75 insertions(+)
 create mode 100644 include/qemu/identity.h
 create mode 100644 util/identity.c

diff --git a/include/qemu/identity.h b/include/qemu/identity.h
new file mode 100644
index 00000000..a0a6df56
--- /dev/null
+++ b/include/qemu/identity.h
@@ -0,0 +1,45 @@
+/*
+ * Machine identity overrides
+ *
+ * A guest can recognise QEMU from a handful of fixed strings: the ACPI
+ * OEM / creator IDs, the SMBIOS default manufacturer, the vendor and
+ * model of the emulated drives, the USB vendor strings and the CPUID
+ * hypervisor signature. Each of them consults an environment variable
+ * before falling back to the upstream value:
+ *
+ *   QEMU_IDENTITY_ACPI_OEM_ID         ACPI OEM ID            ("BOCHS ")
+ *   QEMU_IDENTITY_ACPI_OEM_TABLE_ID   ACPI OEM table ID      ("BXPC    ")
+ *   QEMU_IDENTITY_ACPI_CREATOR_ID     ACPI creator ID        ("BXPC")
+ *   QEMU_IDENTITY_SMBIOS_MANUFACTURER SMBIOS default manufacturer ("QEMU")
+ *   QEMU_IDENTITY_DRIVE_VENDOR        ATAPI / SCSI vendor    ("QEMU")
+ *   QEMU_IDENTITY_HD_MODEL            IDE / SCSI disk model  ("QEMU HARDDISK")
+ *   QEMU_IDENTITY_CD_MODEL            IDE / SCSI CD-ROM model ("QEMU DVD-ROM",
+ *                                     "QEMU CD-ROM")
+ *   QEMU_IDENTITY_USB_VENDOR          USB HID / tablet vendor ("QEMU")
+ *   QEMU_IDENTITY_KVM_SIGNATURE       CPUID 0x40000000 signature ("KVMKVMKVM")
+ *
+ * Unset or empty variables leave the defaults untouched, so a binary
+ * carrying these hooks behaves exactly like upstream unless asked not to.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+#ifndef QEMU_IDENTITY_H
+#define QEMU_IDENTITY_H
+
+/*
+ * Return the override for @key (the part after QEMU_IDENTITY_) or @dflt
+ * when it is unset or empty. The returned pointer stays valid for the
+ * life of the process.
+ */
+const char *qemu_identity_str(const char *key, const char *dflt);
+
+/*
+ * Copy the override for @key (or @dflt) into @buf as a fixed-width field
+ * of exactly @len bytes: truncated when longer, padded with @pad when
+ * shorter. No terminating NUL is written.
+ */
+void qemu_identity_fixed(const char *key, const char *dflt,
+                         char *buf, size_t len, char pad);
+
+#endif
diff --git a/util/identity.c b/util/identity.c
new file mode 100644
index 00000000..993475c1
--- /dev/null
+++ b/util/identity.c
@@ -0,0 +1,29 @@
+/*
+ * Machine identity overrides (see include/qemu/identity.h)
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+#include "qemu/osdep.h"
+#include "qemu/identity.h"
+
+const char *qemu_identity_str(const char *key, const char *dflt)
+{
+    g_autofree char *name = g_strconcat("QEMU_IDENTITY_", key, NULL);
+    const char *val = getenv(name);
+
+    return (val && val[0]) ? val : dflt;
+}
+
+void qemu_identity_fixed(const char *key, const char *dflt,
+                         char *buf, size_t len, char pad)
+{
+    const char *val = qemu_identity_str(key, dflt);
+    size_t n = strlen(val);
+
+    if (n > len) {
+        n = len;
+    }
+    memcpy(buf, val, n);
+    memset(buf + n, pad, len - n);
+}
diff --git a/util/meson.build b/util/meson.build
index c2322ef6..bb4029ca 100644
--- a/util/meson.build
+++ b/util/meson.build
@@ -1,4 +1,5 @@
 util_ss.add(files('osdep.c', 'cutils.c', 'unicode.c', 'qemu-timer-common.c'))
+util_ss.add(files('identity.c'))
 util_ss.add(files('thread-context.c'), numa)
 if not config_host_data.get('CONFIG_ATOMIC64')
   util_ss.add(files('atomic64.c'))
