#!/bin/bash
# appsandbox-replica - a nested QEMU/KVM guest inside an App Sandbox Linux VM
# that looks, from the inside, like a KVM / OpenStack Nova VPS:
#
#   i440FX + PIIX3 chipset, SeaBIOS, Cirrus VGA, virtio disk/net/balloon,
#   USB tablet (absolute pointer, so the VNC cursor tracks the host's),
#   SMBIOS strings from the VM identity profile (or the "host"'s, see
#   --smbios), CPUID hypervisor leaf "KVMKVMKVM", hypervisor CPU flag,
#   systemd-detect-virt = kvm, clocksource kvm-clock.
#
# Everything the guest-side identity overlay cannot fake is real here,
# because it IS a KVM guest. Needs nested virtualization, which App Sandbox
# enables for Linux VMs (/dev/kvm inside the guest).
#
# Usage:  appsandbox-replica [-n NAME] <command> ...     (default name: replica)
#         appsandbox-replica install
#         appsandbox-replica create [--smbios sysinfo|host] [--disk 20G]
#                                   [--ram 4096] [--cpus 4] [--vnc 5900]
#                                   [--profile /etc/appsandbox/identity.json]
#                                   [--image URL] [--video cirrus|virtio]
#         appsandbox-replica reidentify [--restart] [--profile FILE] [--all]
#         appsandbox-replica resize [--cpus 4] [--ram 4096] [--disk 30G] [--restart]
#         appsandbox-replica qemu build|restore|status
#         appsandbox-replica desktop [--no-steam]     # XFCE + Steam + autologin, virtio video
#         appsandbox-replica list                     # every replica as JSON [{name,state,vnc,desktop,cpus,ram,disk}]
#         appsandbox-replica start|stop|destroy|status|ip|ssh [cmd]|console|xml|checks
#
# One sandbox VM can hold several replicas: each has a name (-n), its own
# libvirt domain, disk, ssh key, VNC port and files under
# /var/lib/appsandbox/replica/replicas/<name>; the base image and the patched
# QEMU are shared. The first replica of older installs lives directly in
# /var/lib/appsandbox/replica and keeps working there.
#
# Hypervisor-level identity: the profile keys acpi_oem_id, acpi_oem_table_id,
# acpi_creator_id, smbios_manufacturer, drive_vendor, disk_model, cdrom_model,
# usb_vendor, smbios_vm_bit and "CPUID 0x40000000" are handed to the emulator
# as QEMU_IDENTITY_* environment variables (libvirt <qemu:env>). The stock QEMU
# ignores them; `appsandbox-replica qemu build` builds QEMU 8.2.2 with the
# patches in /opt/appsandbox/qemu-identity (the parameterised form of
# github.com/kila58/qemu-patched) and installs it over the distro binary with
# dpkg-divert. "hypervisor CPU flag": "not set" hides the CPUID hypervisor bit
# (stock QEMU can do that). `reidentify` regenerates the domain from the
# current profile - the agent runs it whenever the profile changes; the
# replica picks the new identity up at its next boot.
#
# The replica's console is served on 127.0.0.1:<vnc port> (default 5900),
# which is exactly what the App Sandbox VNC button tunnels to - so the
# button opens the replica's screen. `ssh` logs in as "user" with a keypair
# generated here (also password test123). Files live in /var/lib/appsandbox/replica.
set -euo pipefail

# -n NAME may precede the command (REPLICA_NAME works too)
if [ "${1:-}" = "-n" ] || [ "${1:-}" = "--name" ]; then
    [ -n "${2:-}" ] || { echo "appsandbox-replica: -n needs a name" >&2; exit 1; }
    REPLICA_NAME=$2; shift 2
fi
NAME=${REPLICA_NAME:-replica}
case "$NAME" in *[!A-Za-z0-9._-]*|"") echo "appsandbox-replica: bad replica name '$NAME' (letters, digits, . _ - only)" >&2; exit 1 ;; esac
ROOT=${REPLICA_ROOT:-/var/lib/appsandbox/replica}   # shared: base image, qemu build
BASE_IMG=$ROOT/base.img
# per-replica files: the legacy first replica sits in $ROOT itself
if [ -n "${REPLICA_DIR:-}" ]; then DIR=$REPLICA_DIR
elif [ "$NAME" = replica ] && [ -f "$ROOT/replica.conf" ]; then DIR=$ROOT
else DIR=$ROOT/replicas/$NAME; fi
DEFAULT_IMAGE=https://cloud-images.ubuntu.com/minimal/releases/noble/release/ubuntu-24.04-minimal-cloudimg-amd64.img
PROFILE=/etc/appsandbox/identity.json
SMBIOS=sysinfo; DISK=20G; RAM=4096; CPUS=4; VNC=5900; IMAGE=$DEFAULT_IMAGE
VIDEO=cirrus      # cirrus = the classic QEMU/OpenStack look; virtio = 2D virtio-vga, larger modes (desktop)
QEMU_SRC=${REPLICA_QEMU_SRC:-/opt/appsandbox/qemu-identity}   # patches + build.sh, shipped in the guest image
QEMU_BIN=/usr/bin/qemu-system-x86_64
QEMU_DISTRIB=/usr/bin/qemu-system-x86_64.distrib
QEMU_STAMP=/opt/appsandbox/qemu-identity.installed
HV_KEYS='acpi_oem_id|acpi_oem_table_id|acpi_creator_id|smbios_manufacturer|smbios_vm_bit|drive_vendor|disk_model|cdrom_model|usb_vendor|CPUID 0x40000000'

die() { echo "appsandbox-replica: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root (sudo)"; }

primary_user() {
    # the interactive account firstboot created (same rule as the agent)
    getent passwd | awk -F: '$3>=1000 && $3<65534 && $6 ~ /^\/home\// && $7 !~ /nologin|false/ {print $1; exit}'
}

cmd_install() {
    need_root
    [ -e /dev/kvm ] || die "/dev/kvm missing: nested virtualization is not available in this VM"
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -q qemu-system-x86 qemu-utils libvirt-daemon-system libvirt-clients \
        cloud-image-utils genisoimage
    systemctl enable --now libvirtd >/dev/null 2>&1 || true
    local u; u=$(primary_user || true)
    [ -n "$u" ] && usermod -aG libvirt,kvm "$u" || true
    # libvirt's NAT network for the replica (dnsmasq on virbr0)
    virsh net-info default >/dev/null 2>&1 || virsh net-define /usr/share/libvirt/networks/default.xml >/dev/null
    virsh net-autostart default >/dev/null 2>&1 || true
    virsh net-start default >/dev/null 2>&1 || true
    echo "OK: qemu/libvirt installed, default network up"
}

gen_xml() {
    # $1 = uuid, $2 = MAC (fixed: cloud-init pins the guest's netplan config to
    # it, so a redefined domain must keep it or the replica loses its DHCP
    # lease); reads PROFILE (either [{check,name}] or {key:value}) via python3
    python3 - "$NAME" "$RAM" "$CPUS" "$DIR" "$VNC" "$SMBIOS" "$PROFILE" "$1" "$2" "$VIDEO" <<'PY'
import json, sys, html, os
name, ram, cpus, d, vnc, mode, prof_path, uuid, mac, video = sys.argv[1:11]
video_xml = "<model type='cirrus' vram='16384' heads='1'/>"
if video == "virtio":
    video_xml = "<model type='virtio' heads='1'><resolution x='1600' y='900'/></model>"
prof = {}
if os.path.exists(prof_path):
    try:
        data = json.load(open(prof_path))
        if isinstance(data, list):
            prof = {str(e.get("check", "")).strip(): str(e.get("name", "")).strip() for e in data if isinstance(e, dict)}
        elif isinstance(data, dict):
            prof = {str(k).strip(): str(v).strip() for k, v in data.items()}
    except Exception:
        pass
def g(k, default): return html.escape(prof.get(k) or default)
def opt(name, key):
    # optional <entry> from a profile key (omitted when the profile has no value)
    return ("      <entry name='%s'>%s</entry>\n" % (name, html.escape(prof[key]))) if prof.get(key) else ""
# hypervisor-level keys -> QEMU_IDENTITY_* in the emulator's environment
# (honoured by the identity-patched QEMU, ignored by the stock one)
ENV_KEYS = [("acpi_oem_id", "ACPI_OEM_ID"), ("acpi_oem_table_id", "ACPI_OEM_TABLE_ID"),
            ("acpi_creator_id", "ACPI_CREATOR_ID"), ("smbios_manufacturer", "SMBIOS_MANUFACTURER"),
            ("drive_vendor", "DRIVE_VENDOR"), ("disk_model", "HD_MODEL"), ("cdrom_model", "CD_MODEL"),
            ("usb_vendor", "USB_VENDOR"), ("CPUID 0x40000000", "KVM_SIGNATURE")]
OFF = ("not set", "unset", "off", "hidden", "no", "false", "0")
env = "".join("    <qemu:env name='QEMU_IDENTITY_%s' value='%s'/>\n" % (v, html.escape(prof[k], quote=True))
              for k, v in ENV_KEYS if prof.get(k))
# "hypervisor CPU flag": "not set" -> hide the CPUID hypervisor bit (stock QEMU can)
hv_off = prof.get("hypervisor CPU flag", "").lower() in OFF
# smbios_vm_bit: the SMBIOS type 0 "Virtual Machine" characteristic (what
# systemd-detect-virt reads as root); off explicitly, or implied by a hidden
# hypervisor bit unless the profile says otherwise
vm_bit = prof.get("smbios_vm_bit", "").lower()
if vm_bit in OFF or (hv_off and not vm_bit):
    env += "    <qemu:env name='QEMU_IDENTITY_SMBIOS_VM_BIT' value='0'/>\n"
cmdline = "  <qemu:commandline>\n%s  </qemu:commandline>\n" % env if env else ""
cpu = "  <cpu mode='host-passthrough' check='none'/>"
if hv_off:
    cpu = "  <cpu mode='host-passthrough' check='none'>\n    <feature policy='disable' name='hypervisor'/>\n  </cpu>"
# bios_vendor is either "vendor" (with a separate bios_version key) or the
# combined "vendor version" form the checks print ("SeaBIOS 1.16.3-debian")
bios = prof.get("bios_vendor") or "SeaBIOS 1.16.3-debian"
if prof.get("bios_version"):
    bios_vendor, bios_version = bios, prof["bios_version"]
else:
    bios_vendor, _, bios_version = bios.partition(" ")
board = "".join(opt(n, k) for n, k in (("manufacturer", "board_vendor"), ("product", "board_name"),
                                        ("version", "board_version"), ("serial", "board_serial"),
                                        ("asset", "board_asset_tag")))
sysinfo = ""
if mode == "sysinfo":
    sysinfo = """  <sysinfo type='smbios'>
    <bios>
      <entry name='vendor'>%s</entry>
      <entry name='version'>%s</entry>
%s    </bios>
    <system>
      <entry name='manufacturer'>%s</entry>
      <entry name='product'>%s</entry>
      <entry name='version'>%s</entry>
      <entry name='serial'>%s</entry>
      <entry name='uuid'>%s</entry>
      <entry name='family'>%s</entry>
    </system>
%s    <chassis>
      <entry name='manufacturer'>%s</entry>
%s    </chassis>
  </sysinfo>
""" % (html.escape(bios_vendor), html.escape(bios_version or "1.16.3-debian"), opt("date", "bios_date"),
       g("sys_vendor", "OpenStack Foundation"), g("product_name", "OpenStack Nova"),
       g("product_version", "2024.1"), g("product_serial", uuid), uuid, g("product_family", "Virtual Machine"),
       ("    <baseBoard>\n%s    </baseBoard>\n" % board) if board else "",
       g("chassis_vendor", "QEMU"),
       opt("version", "chassis_version") + opt("serial", "chassis_serial") + opt("asset", "chassis_asset_tag"))
print("""<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>%s</name>
  <uuid>%s</uuid>
  <memory unit='MiB'>%s</memory>
  <vcpu placement='static'>%s</vcpu>
  <os>
    <type arch='x86_64' machine='pc'>hvm</type>
    <boot dev='hd'/>
    <smbios mode='%s'/>
  </os>
%s  <features><acpi/><apic/></features>
%s
  <clock offset='utc'>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='%s/disk.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='%s/seed.iso'/>
      <target dev='hda' bus='ide'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <mac address='%s'/>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <graphics type='vnc' port='%s' autoport='no' listen='127.0.0.1'/>
    <video>%s</video>
    <input type='tablet' bus='usb'/>
    <memballoon model='virtio'/>
    <rng model='virtio'><backend model='random'>/dev/urandom</backend></rng>
  </devices>
%s</domain>""" % (name, uuid, ram, cpus, mode, sysinfo, cpu, d, d, mac, vnc, video_xml, cmdline))
PY
}

qemu_patched_installed() {
    [ -f "$QEMU_STAMP" ] && dpkg-divert --list "$QEMU_BIN" 2>/dev/null | grep -q "$QEMU_DISTRIB"
}

# Tell the user when the profile asks for something only the patched QEMU does.
hv_note() {
    [ -f "$PROFILE" ] || return 0
    if grep -qE "\"($HV_KEYS)\"" "$PROFILE" && ! qemu_patched_installed; then
        echo "note: the profile has hypervisor-level keys (ACPI / SMBIOS / drive / CPUID strings)."
        echo "      The stock QEMU ignores them: run 'sudo appsandbox-replica qemu build' once (~10 min),"
        echo "      then 'sudo appsandbox-replica reidentify --restart'."
    fi
}

DESKTOP=0
save_conf() {
    printf "RAM='%s'\nCPUS='%s'\nVNC='%s'\nSMBIOS='%s'\nPROFILE='%s'\nUUID='%s'\nMAC='%s'\nVIDEO='%s'\nDESKTOP='%s'\nDISK='%s'\n" \
        "$RAM" "$CPUS" "$VNC" "$SMBIOS" "$PROFILE" "$1" "$2" "$VIDEO" "$DESKTOP" "$DISK" > "$DIR/replica.conf"
}

# a size like 20G / 512M / 30 (bare = GiB) -> bytes
size_bytes() {
    case "$1" in
        *[Gg]) echo $(( ${1%[Gg]} * 1073741824 )) ;;
        *[Mm]) echo $(( ${1%[Mm]} * 1048576 )) ;;
        *[!0-9]*|"") echo 0 ;;
        *) echo $(( $1 * 1073741824 )) ;;
    esac
}

# the virtual size of a replica's disk image, in bytes. The human-readable
# qemu-img output is used on purpose: its JSON form carries several
# "virtual-size" keys (the file node, the backing image) and the first one
# is not the overlay's.
image_bytes() {   # $1 = qcow2 path
    qemu-img info -U "$1" 2>/dev/null | sed -n 's/^virtual size:.*(\([0-9]*\) bytes).*/\1/p' | head -1
}

# a replica's disk in GiB: DISK from replica.conf, else (older replicas) the
# image's virtual size
disk_gb() {   # $1 = replica dir, $2 = DISK from its conf (may be empty)
    local b
    case "$2" in
        "") ;;
        *[Gg]) echo "${2%[Gg]}"; return ;;
        *[Mm]) echo $(( ${2%[Mm]} / 1024 )); return ;;
        *[!0-9]*) ;;
        *) echo "$2"; return ;;
    esac
    b=$(image_bytes "$1/disk.qcow2")
    echo $(( ${b:-0} / 1073741824 ))
}

# every replica on this VM, as JSON: [{"name","state","vnc","desktop","cpus","ram","disk"}, ...]
# (ram in MiB, disk in GiB)
cmd_list() {
    local d name state vnc desk ram cpus disk
    echo "["
    local first=1
    for d in "$ROOT" "$ROOT"/replicas/*; do
        [ -f "$d/replica.conf" ] || continue
        if [ "$d" = "$ROOT" ]; then name=replica; else name=$(basename "$d"); fi
        vnc=$(sed -n "s/^VNC='\(.*\)'/\1/p" "$d/replica.conf"); desk=$(sed -n "s/^DESKTOP='\(.*\)'/\1/p" "$d/replica.conf")
        ram=$(sed -n "s/^RAM='\(.*\)'/\1/p" "$d/replica.conf"); cpus=$(sed -n "s/^CPUS='\(.*\)'/\1/p" "$d/replica.conf")
        disk=$(disk_gb "$d" "$(sed -n "s/^DISK='\(.*\)'/\1/p" "$d/replica.conf")")
        state=$(virsh domstate "$name" 2>/dev/null | head -1)
        case "$state" in running) state=running ;; "") state=undefined ;; *) state=stopped ;; esac
        [ $first = 1 ] || echo ","
        first=0
        printf '  {"name": "%s", "state": "%s", "vnc": %s, "desktop": %s, "cpus": %s, "ram": %s, "disk": %s}' \
            "$name" "$state" "${vnc:-0}" "$([ "${desk:-0}" = 1 ] && echo true || echo false)" "${cpus:-0}" "${ram:-0}" "${disk:-0}"
    done
    echo; echo "]"
}

# Cores, RAM and disk of an existing replica. Cores / RAM go into the domain
# XML (gen_xml reads RAM and CPUS) and apply at the next boot - or now, with
# --restart. The disk grows in place (live through libvirt when the replica
# runs, qemu-img otherwise); the guest's cloud-init growpart + resizefs then
# extend the root filesystem at its next boot. Shrinking is refused.
cmd_resize() {
    need_root
    [ -f "$DIR/replica.conf" ] || die "no replica '$NAME' here (appsandbox-replica -n $NAME create first)"
    # shellcheck disable=SC1091
    MAC=""; DESKTOP=0; DISK=""; . "$DIR/replica.conf"        # RAM CPUS VNC SMBIOS PROFILE UUID MAC VIDEO DESKTOP DISK
    local restart=0 new_disk="" changed=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --cpus) CPUS=$2; changed="$changed cpus"; shift 2 ;;
            --ram) RAM=$2; changed="$changed ram"; shift 2 ;;
            --disk) new_disk=$2; shift 2 ;;
            --restart) restart=1; shift ;;
            *) die "unknown option $1" ;;
        esac
    done
    case "$CPUS" in ''|*[!0-9]*) die "--cpus must be a number" ;; esac
    case "$RAM" in ''|*[!0-9]*) die "--ram must be a number (MiB)" ;; esac
    [ "$CPUS" -ge 1 ] || die "--cpus must be at least 1"
    [ "$RAM" -ge 256 ] || die "--ram must be at least 256 (MiB)"
    virsh dominfo "$NAME" >/dev/null 2>&1 || die "domain '$NAME' is not defined (appsandbox-replica create)"
    local running=0
    virsh domstate "$NAME" 2>/dev/null | grep -q running && running=1
    [ -n "$DISK" ] || DISK="$(disk_gb "$DIR" "")G"
    if [ -n "$new_disk" ]; then
        case "$new_disk" in *[!0-9]*) ;; *) new_disk="${new_disk}G" ;; esac
        local want cur
        want=$(size_bytes "$new_disk")
        [ "$want" -gt 0 ] || die "--disk must look like 30G"
        cur=$(image_bytes "$DIR/disk.qcow2")
        [ -n "$cur" ] && [ "$cur" -gt 0 ] || die "cannot read the size of $DIR/disk.qcow2"
        # Never hand QEMU a smaller size: block_resize shrinks a qcow2 without
        # asking and drops everything past the new end.
        if [ "$want" -gt "$cur" ]; then
            if [ $running = 1 ]; then
                virsh blockresize "$NAME" vda "$new_disk" >/dev/null
            else
                qemu-img resize -q "$DIR/disk.qcow2" "$new_disk"
            fi
            DISK=$new_disk; changed="$changed disk"
        elif [ "$want" -lt "$cur" ]; then
            die "the disk can only grow (it is $(( cur / 1073741824 )) GiB now)"
        fi
    fi
    if [ -z "$MAC" ]; then
        MAC=$(virsh dumpxml "$NAME" | sed -n "s/.*<mac address='\([^']*\)'.*/\1/p" | head -1)
    fi
    gen_xml "$UUID" "$MAC" > "$DIR/$NAME.xml"
    save_conf "$UUID" "$MAC"
    virsh define "$DIR/$NAME.xml" >/dev/null
    echo "OK: replica '$NAME' -> $CPUS cpus, $RAM MiB, disk $DISK (changed:${changed:- nothing})"
    if [ $running = 1 ]; then
        if [ $restart = 1 ]; then
            virsh destroy "$NAME" >/dev/null; sleep 1; virsh start "$NAME" >/dev/null
            echo "    restarted; the new size is in effect"
        else
            echo "    cores / RAM and the bigger root filesystem show after its next boot (appsandbox-replica -n $NAME stop + start)"
        fi
    elif [ $restart = 1 ]; then
        virsh start "$NAME" >/dev/null
        echo "    started"
    else
        echo "    applies when it starts"
    fi
}

cmd_create() {
    need_root
    while [ $# -gt 0 ]; do
        case "$1" in
            --smbios) SMBIOS=$2; shift 2 ;;
            --disk) DISK=$2; shift 2 ;;
            --ram) RAM=$2; shift 2 ;;
            --cpus) CPUS=$2; shift 2 ;;
            --vnc) VNC=$2; shift 2 ;;
            --profile) PROFILE=$2; shift 2 ;;
            --image) IMAGE=$2; shift 2 ;;
            --video) VIDEO=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    case "$SMBIOS" in sysinfo|host) ;; *) die "--smbios must be sysinfo or host" ;; esac
    case "$VIDEO" in cirrus|virtio) ;; *) die "--video must be cirrus or virtio" ;; esac
    command -v virsh >/dev/null || cmd_install
    # 5900 may already be taken by something the user runs in this VM (x11vnc,
    # a docker container publishing 127.0.0.1:5900 ...): pick the next free port.
    local want=$VNC
    while ss -ltn 2>/dev/null | awk '{print $4}' | grep -q ":$VNC\$"; do VNC=$((VNC + 1)); [ $VNC -gt $((want + 20)) ] && die "no free VNC port near $want"; done
    [ "$VNC" != "$want" ] && echo "note: 127.0.0.1:$want is in use, replica console on 127.0.0.1:$VNC instead"
    mkdir -p "$DIR" "$ROOT"; cd "$DIR"
    if virsh dominfo "$NAME" >/dev/null 2>&1; then
        die "domain '$NAME' already exists (appsandbox-replica -n $NAME destroy first)"
    fi
    if [ ! -s "$BASE_IMG" ]; then
        echo "downloading $IMAGE ..."
        curl -fL --retry 3 -o "$BASE_IMG.part" "$IMAGE" && mv "$BASE_IMG.part" "$BASE_IMG"
    fi
    qemu-img create -q -f qcow2 -b "$BASE_IMG" -F qcow2 disk.qcow2 "$DISK"
    # ssh keypair for `appsandbox-replica ssh`
    [ -f id_ed25519 ] || ssh-keygen -q -t ed25519 -N "" -f id_ed25519 -C appsandbox-replica
    local pub; pub=$(cat id_ed25519.pub)
    local u; u=$(primary_user || echo user)
    local extra_keys=""
    if [ -s "/home/$u/.ssh/authorized_keys" ]; then
        extra_keys=$(sed 's/^/      - /' "/home/$u/.ssh/authorized_keys")
    fi
    cat > user-data <<EOF
#cloud-config
hostname: $NAME
manage_etc_hosts: true
ssh_pwauth: true
users:
  - name: user
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: test123
    ssh_authorized_keys:
      - $pub
$extra_keys
package_update: false
growpart: {mode: auto, devices: ["/"]}
EOF
    printf 'instance-id: %s-1\nlocal-hostname: %s\n' "$NAME" "$NAME" > meta-data
    cloud-localds seed.iso user-data meta-data
    local uuid; uuid=$(cat /proc/sys/kernel/random/uuid)
    local mac; mac=$(printf '52:54:00:%02x:%02x:%02x' $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)))
    gen_xml "$uuid" "$mac" > "$NAME.xml"
    save_conf "$uuid" "$mac"
    virsh define "$NAME.xml" >/dev/null
    virsh autostart "$NAME" >/dev/null 2>&1 || true   # comes back with the sandbox VM, so the screen button is there
    virsh start "$NAME" >/dev/null
    echo "OK: replica '$NAME' defined and started (smbios=$SMBIOS, vnc 127.0.0.1:$VNC, qemu=$(qemu_patched_installed && echo identity-patched || echo stock))"
    echo "    XML: $DIR/$NAME.xml   (edit + 'virsh define' to tweak, e.g. <smbios mode='host'/>)"
    echo "    first boot takes ~1 min (cloud-init); then: appsandbox-replica -n $NAME ssh"
    hv_note
}

# Regenerate the domain XML from the current identity profile (same size /
# ports / uuid as at create time) and redefine it. ACPI, SMBIOS, drive and
# CPUID strings are fixed at boot, so a running replica keeps the old ones
# until it restarts (--restart does that now).
cmd_reidentify() {
    need_root
    if [ "${1:-}" = "--all" ]; then
        # every replica on this VM (the agent runs this after a profile change)
        shift
        local n
        for n in $(cmd_list | sed -n 's/.*"name": "\([^"]*\)".*/\1/p'); do
            REPLICA_NAME=$n REPLICA_DIR= "$0" -n "$n" reidentify "$@" || true
        done
        return 0
    fi
    [ -f "$DIR/replica.conf" ] || die "no replica '$NAME' here (appsandbox-replica -n $NAME create first)"
    # shellcheck disable=SC1091
    MAC=""; DESKTOP=0; . "$DIR/replica.conf"        # RAM CPUS VNC SMBIOS PROFILE UUID MAC VIDEO DESKTOP
    local restart=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --restart) restart=1; shift ;;
            --profile) PROFILE=$2; shift 2 ;;
            --video) VIDEO=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    case "$VIDEO" in cirrus|virtio) ;; *) die "--video must be cirrus or virtio" ;; esac
    virsh dominfo "$NAME" >/dev/null 2>&1 || die "domain '$NAME' is not defined (appsandbox-replica create)"
    if [ -z "$MAC" ]; then   # replica created before the MAC was recorded: keep the one it has
        MAC=$(virsh dumpxml "$NAME" | sed -n "s/.*<mac address='\([^']*\)'.*/\1/p" | head -1)
        [ -n "$MAC" ] && save_conf "$UUID" "$MAC"
    fi
    gen_xml "$UUID" "$MAC" > "$DIR/$NAME.xml"
    save_conf "$UUID" "$MAC"
    virsh define "$DIR/$NAME.xml" >/dev/null
    local src="$PROFILE"; [ -f "$PROFILE" ] || src="no profile (defaults)"
    if virsh domstate "$NAME" 2>/dev/null | grep -q running; then
        if [ "$restart" = 1 ]; then
            virsh destroy "$NAME" >/dev/null; virsh start "$NAME" >/dev/null
            echo "OK: replica redefined from $src and restarted"
        else
            echo "OK: replica redefined from $src; the new identity shows after its next boot"
            echo "    (appsandbox-replica stop + start, or 'reidentify --restart')"
        fi
    else
        echo "OK: replica redefined from $src; applies when it starts"
    fi
    hv_note
}

# The identity-patched QEMU (see /opt/appsandbox/qemu-identity/README.md):
# built from the upstream 8.2.2 tarball + patches, installed over the distro
# binary with dpkg-divert so libvirt, AppArmor and the firmware paths are
# untouched. `restore` puts the distro binary back.
cmd_qemu() {
    case "${1:-status}" in
        build)
            need_root; shift
            [ -x "$QEMU_SRC/build.sh" ] || [ -f "$QEMU_SRC/build.sh" ] \
                || die "no $QEMU_SRC/build.sh (the patches + build script ship in the guest image under /opt/appsandbox)"
            [ -x "$QEMU_BIN" ] || [ -x "$QEMU_DISTRIB" ] || cmd_install
            exec bash "$QEMU_SRC/build.sh" "$@" ;;
        restore)
            need_root
            if dpkg-divert --list "$QEMU_BIN" 2>/dev/null | grep -q "$QEMU_DISTRIB"; then
                rm -f "$QEMU_BIN"
                dpkg-divert --quiet --local --rename --remove "$QEMU_BIN"
                rm -f "$QEMU_STAMP"
                rm -f /var/cache/libvirt/qemu/capabilities/*.xml 2>/dev/null || true
                systemctl try-restart libvirtd 2>/dev/null || true
                echo "OK: distro qemu-system-x86_64 restored (running replica keeps the patched one until restarted)"
            else
                echo "stock qemu-system-x86_64 already in place"
            fi ;;
        status)
            if qemu_patched_installed; then
                echo "identity-patched QEMU $(sed -n 's/^version=//p' "$QEMU_STAMP") at $QEMU_BIN (distro binary kept at $QEMU_DISTRIB)"
            else
                echo "stock $QEMU_BIN: $("$QEMU_BIN" --version 2>/dev/null | head -1 || echo "not installed")"
                echo "run 'sudo appsandbox-replica qemu build' for the identity-patched one"
            fi ;;
        *) die "usage: appsandbox-replica qemu build|restore|status" ;;
    esac
}

cmd_ip() {
    virsh domifaddr "$NAME" 2>/dev/null | awk '/ipv4/ {sub(/\/.*/, "", $4); print $4; exit}'
}

ssh_run() {
    # run a command in the replica and return (cmd_ssh execs, for the interactive case)
    local ip; ip=$(cmd_ip)
    [ -n "$ip" ] || die "replica has no IP yet (is it running? try again in a moment)"
    ssh -i "$DIR/id_ed25519" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 "user@$ip" "$@"
}

cmd_ssh() {
    local ip; ip=$(cmd_ip)
    [ -n "$ip" ] || die "replica has no IP yet (is it running? try again in a moment)"
    exec ssh -i "$DIR/id_ed25519" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "user@$ip" "$@"
}

# Turn the replica into a usable desktop: XFCE (xubuntu-core) + LightDM
# autologin for "user", Steam (i386 multiarch + steam-installer), and the
# virtio video model (1600x900) instead of Cirrus. Rendering is software
# (llvmpipe): there is no GPU in the replica, so this is for the Steam client,
# store and light games - not for GPU-heavy titles. Console: the App Sandbox
# VNC button. Re-runnable.
cmd_desktop() {
    need_root
    local steam=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-steam) steam=0; shift ;;
            *) die "unknown option $1" ;;
        esac
    done
    [ -f "$DIR/replica.conf" ] || die "no replica '$NAME' here (appsandbox-replica -n $NAME create first)"
    virsh domstate "$NAME" 2>/dev/null | grep -q running || { virsh start "$NAME" >/dev/null 2>&1 || true; }
    local i
    for i in $(seq 1 36); do ssh_run true 2>/dev/null && break; sleep 5; done
    ssh_run true 2>/dev/null || die "cannot reach the replica over ssh"
    echo "==> installing XFCE desktop$( [ $steam = 1 ] && echo ' + Steam') in the replica (10-20 min, ~1.5 GB download) ..."
    ssh_run "sudo STEAM=$steam bash -s" <<'EOF'
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -y -q xubuntu-core lightdm xterm dbus-x11
# no lock screen / screensaver on a VNC console
apt-get purge -y -q light-locker xfce4-screensaver >/dev/null 2>&1 || true
install -d /etc/lightdm/lightdm.conf.d
printf '[Seat:*]\nautologin-user=user\nautologin-user-timeout=0\nautologin-session=xubuntu\nuser-session=xubuntu\n' > /etc/lightdm/lightdm.conf.d/50-appsandbox-autologin.conf
systemctl set-default graphical.target
systemctl enable lightdm >/dev/null 2>&1 || true
if [ "$STEAM" = 1 ]; then
    dpkg --add-architecture i386
    apt-get update -q
    echo steam steam/question select "I AGREE" | debconf-set-selections
    echo steam steam/license note '' | debconf-set-selections
    apt-get install -y -q steam-installer || apt-get install -y -q steam
    # software GL: keep the Steam UI on the CPU renderer
    install -d -o user -g user /home/user/.config/autostart
fi
echo "desktop: OK"
EOF
    # virtio video for a real resolution (Cirrus tops out at 1024x768)
    MAC=""; VIDEO=cirrus; DESKTOP=0
    # shellcheck disable=SC1091
    . "$DIR/replica.conf"
    VIDEO=virtio; DESKTOP=1
    gen_xml "$UUID" "$MAC" > "$DIR/$NAME.xml"
    save_conf "$UUID" "$MAC"
    virsh define "$DIR/$NAME.xml" >/dev/null
    echo "==> restarting the replica into the desktop"
    virsh autostart "$NAME" >/dev/null 2>&1 || true
    virsh destroy "$NAME" >/dev/null 2>&1 || true
    virsh start "$NAME" >/dev/null
    echo "OK: replica desktop ready in ~1 min. Open it with the App Sandbox VNC button"
    echo "    (user 'user' logs in automatically; password test123). Steam: menu > Games > Steam,"
    echo "    or 'steam' in a terminal - the first start downloads the Steam runtime (~500 MB)."
}

cmd_checks() {
    # the identity checks, printed in the [{check,name}] format: the nine
    # guest-visible ones plus what only the emulator decides (ACPI header
    # IDs, SMBIOS processor manufacturer, CD-ROM vendor/model)
    cmd_ssh 'sudo modprobe cpuid 2>/dev/null; sudo python3 - <<"PY"
import json, subprocess, os
def cat(p):
    try: return open(p).read().strip()
    except OSError: return "?"
def sh(c): return subprocess.run(c, shell=True, capture_output=True, text=True).stdout.strip()
def raw(p, n=None):
    try:
        with open(p, "rb") as f: return f.read(n) if n else f.read()
    except OSError: return b""
def field(b, a, z): return b[a:z].decode("ascii", "replace").strip(" \x00") if len(b) >= z else "?"
def smbios_str(entry, off):
    # DMI structure: header (type, length, handle), formatted area, then the string set
    b = raw("/sys/firmware/dmi/entries/%s/raw" % entry)
    if len(b) < 4 or len(b) <= off: return "?"
    n, idx = b[1], b[off]
    strs = b[n:].split(b"\x00")
    return strs[idx - 1].decode("ascii", "replace").strip() if 0 < idx <= len(strs) else ""
out = [{"check": k, "name": cat("/sys/class/dmi/id/" + k)} for k in ("sys_vendor", "product_name")]
out.append({"check": "bios_vendor", "name": (cat("/sys/class/dmi/id/bios_vendor") + " " + cat("/sys/class/dmi/id/bios_version")).strip()})
out.append({"check": "chassis_vendor", "name": cat("/sys/class/dmi/id/chassis_vendor")})
pci = sh("lspci 2>/dev/null")
parts = []
if "440FX" in pci: parts.append("440FX")
if "PIIX3" in pci: parts.append("PIIX3")
chip = " + ".join(parts)
if "Cirrus" in pci: chip += ", Cirrus VGA"
if "Virtio" in pci or "virtio" in pci: chip += ", virtio"
out.append({"check": "chipset", "name": chip or "?"})
sig = "?"
try:
    f = open("/dev/cpu/0/cpuid", "rb", 0); f.seek(0x40000000); d = f.read(16)
    sig = (d[4:8] + d[8:12] + d[12:16]).decode("ascii", "replace").rstrip("\x00")
except OSError: pass
out.append({"check": "CPUID 0x40000000", "name": sig})
out.append({"check": "hypervisor CPU flag", "name": "set" if " hypervisor" in open("/proc/cpuinfo").read() else "not set"})
out.append({"check": "systemd-detect-virt", "name": sh("systemd-detect-virt")})
out.append({"check": "clocksource", "name": cat("/sys/devices/system/clocksource/clocksource0/current_clocksource")})
dsdt = raw("/sys/firmware/acpi/tables/DSDT", 36)
out.append({"check": "acpi_oem_id", "name": field(dsdt, 10, 16)})
out.append({"check": "acpi_oem_table_id", "name": field(dsdt, 16, 24)})
out.append({"check": "acpi_creator_id", "name": field(dsdt, 28, 32)})
out.append({"check": "smbios_manufacturer", "name": smbios_str("4-0", 7)})
t0 = raw("/sys/firmware/dmi/entries/0-0/raw")
out.append({"check": "smbios_vm_bit", "name": ("set" if t0[0x13] & 0x10 else "not set") if len(t0) > 0x13 else "?"})
cd = [d for d in sorted(os.listdir("/sys/block")) if d.startswith("sr")]
out.append({"check": "drive_vendor", "name": cat("/sys/block/%s/device/vendor" % cd[0]) if cd else "?"})
out.append({"check": "cdrom_model", "name": cat("/sys/block/%s/device/model" % cd[0]) if cd else "?"})
print(json.dumps(out, indent=2))
PY'
}

cmd=${1:-status}; shift || true
case "$cmd" in
    install) cmd_install ;;
    create)  cmd_create "$@" ;;
    reidentify) cmd_reidentify "$@" ;;
    resize)  cmd_resize "$@" ;;
    qemu)    cmd_qemu "$@" ;;
    desktop) cmd_desktop "$@" ;;
    start)   need_root; virsh start "$NAME" ;;
    stop)    need_root; virsh shutdown "$NAME" ;;
    destroy) need_root; virsh destroy "$NAME" 2>/dev/null || true; virsh undefine "$NAME" 2>/dev/null || true
             rm -f "$DIR/disk.qcow2" "$DIR/seed.iso" "$DIR/$NAME.xml" "$DIR/replica.conf" "$DIR/user-data" "$DIR/meta-data" "$DIR/id_ed25519" "$DIR/id_ed25519.pub"
             [ "$DIR" != "$ROOT" ] && rmdir "$DIR" 2>/dev/null; echo "replica '$NAME' removed (base image kept in $ROOT)" ;;
    list)    cmd_list ;;
    status)  virsh dominfo "$NAME" 2>/dev/null | grep -E "^(Name|State|CPU\(s\)|Max memory)" || echo "no replica '$NAME' defined"
             ip=$(cmd_ip || true); [ -n "$ip" ] && echo "IP:              $ip" || true
             echo "replicas on this VM:"; cmd_list ;;
    ip)      cmd_ip ;;
    ssh)     cmd_ssh "$@" ;;
    console) exec virsh console "$NAME" ;;
    xml)     cat "$DIR/$NAME.xml" ;;
    checks)  cmd_checks ;;
    *)       die "unknown command '$cmd' (install|create|reidentify|qemu|desktop|list|start|stop|destroy|status|ip|ssh|console|xml|checks)" ;;
esac
