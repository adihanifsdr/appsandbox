<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- QEMU uses Hypervisor.framework (HVF) for hardware acceleration; without this
         entitlement hv_vm_create is denied. Sign the qemu binary with this. -->
    <key>com.apple.security.hypervisor</key>
    <true/>
</dict>
</plist>
